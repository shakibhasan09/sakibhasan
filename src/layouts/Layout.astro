---
import "@/styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Sakib Hasan — software engineer",
    description = "i'm sakib, a full-stack software engineer who loves building stuff on the web with Go, TypeScript, and Cloudflare Workers.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isActive = (href: string) =>
    href === "/" ? path === "/" : path.startsWith(href);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="canonical" href={canonicalURL} />
        <meta name="generator" content={Astro.generator} />

        <title>{title}</title>
        <meta name="description" content={description} />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:site_name" content="Sakib Hasan" />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />

        <!-- Fonts: Rubik (matches nize.ph) + JetBrains Mono for code -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;900&family=JetBrains+Mono:wght@400;500&display=swap"
            rel="stylesheet"
        />

        <script is:inline>
            const stored = localStorage.getItem("theme");
            const prefers = window.matchMedia(
                "(prefers-color-scheme: dark)",
            ).matches;
            if (stored === "dark" || (!stored && prefers)) {
                document.documentElement.classList.add("dark");
            }
        </script>
    </head>
    <body class="min-h-screen flex flex-col">
        <header class="mx-auto w-full max-w-2xl px-6 pt-16 sm:pt-24 pb-6">
            <div class="flex items-center justify-between">
                <a
                    href="/"
                    class="block rounded-xl ring-1 ring-border overflow-hidden hover:ring-foreground/40 transition"
                    aria-label="home"
                >
                    <img
                        src="/avatar.svg"
                        alt="sakib's avatar"
                        width="44"
                        height="44"
                        class="block"
                    />
                </a>
                <nav>
                    <ul class="flex items-center gap-5 text-base">
                        <li>
                            <a
                                href="/"
                                class={`hover:text-primary transition ${isActive("/") ? "text-foreground font-medium" : "text-muted-foreground"}`}
                                >home</a
                            >
                        </li>
                        <li>
                            <a
                                href="/projects"
                                class={`hover:text-primary transition ${isActive("/projects") ? "text-foreground font-medium" : "text-muted-foreground"}`}
                                >work</a
                            >
                        </li>
                        <li>
                            <a
                                href="/blog"
                                class={`hover:text-primary transition ${isActive("/blog") ? "text-foreground font-medium" : "text-muted-foreground"}`}
                                >notes</a
                            >
                        </li>
                        <li>
                            <button
                                type="button"
                                id="theme-toggle"
                                aria-label="Toggle theme"
                                class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-foreground text-background hover:opacity-90 transition cursor-pointer"
                            >
                                <svg
                                    class="h-4 w-4 hidden dark:block"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    viewBox="0 0 24 24"
                                >
                                    <circle cx="12" cy="12" r="4"></circle>
                                    <path
                                        stroke-linecap="round"
                                        d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
                                    ></path>
                                </svg>
                                <svg
                                    class="h-4 w-4 dark:hidden"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"
                                    ></path>
                                </svg>
                            </button>
                        </li>
                    </ul>
                </nav>
            </div>
        </header>

        <main class="mx-auto w-full max-w-2xl px-6 flex-1">
            <slot />
        </main>

        <footer class="mx-auto w-full max-w-2xl px-6 mt-24 mb-16">
            <div class="text-2xl sm:text-3xl font-bold mb-3">
                let's work together
            </div>
            <div
                class="flex flex-wrap items-center gap-x-3 gap-y-2 text-lg text-muted-foreground"
            >
                <a
                    href="/contact"
                    class="inline-flex items-center gap-1.5 text-foreground hover:text-primary transition"
                >
                    <svg
                        class="h-4 w-4"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                        ></path></svg
                    >
                    send a message
                </a>
                <span>or</span>
                <a
                    href="https://github.com/shakibhasan09"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-foreground hover:text-primary transition"
                >
                    <svg
                        class="h-4 w-4"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                        ></path></svg
                    >
                    find me on github
                </a>
            </div>
            <p
                class="text-sm text-muted-foreground mt-10 pt-6 border-t border-border"
            >
                &copy; {new Date().getFullYear()} sakib hasan.
            </p>
        </footer>

        <script is:inline>
            const btn = document.getElementById("theme-toggle");
            btn?.addEventListener("click", () => {
                const dark = document.documentElement.classList.toggle("dark");
                localStorage.setItem("theme", dark ? "dark" : "light");
            });
        </script>
    </body>
</html>
