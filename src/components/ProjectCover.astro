---
import { Image } from "astro:assets";

interface Props {
    cover?: ImageMetadata;
    coverDark?: ImageMetadata;
    title: string;
    coverBg?: string;
    coverBgDark?: string;
    size?: "sm" | "lg";
    hover?: boolean;
    eager?: boolean;
    badge?: string;
}

const {
    cover,
    coverDark,
    title,
    coverBg,
    coverBgDark,
    size = "sm",
    hover = false,
    eager = false,
    badge,
} = Astro.props;

const bgLight = coverBg ?? "#f4f4f5";
const bgDark = coverBgDark ?? coverBg ?? "#18181b";

const imgClass = [
    "w-full h-full object-cover",
    hover && "transition duration-500 group-hover:scale-[1.02]",
];

const widths = size === "lg" ? [480, 720, 1080, 1440] : [360, 540, 720, 1080];
const sizes =
    size === "lg"
        ? "(min-width: 768px) 640px, 100vw"
        : "(min-width: 640px) 320px, 100vw";
---

<div
    class:list={[
        "cover-bg aspect-16/10 rounded-xl overflow-hidden relative flex items-center justify-center",
        hover && "transition",
    ]}
    style={`--cover-bg-light: ${bgLight}; --cover-bg-dark: ${bgDark};`}
>
    {
        cover || coverDark ? (
            <>
                {cover && (
                    <Image
                        src={cover}
                        alt={title}
                        widths={widths}
                        sizes={sizes}
                        loading={eager ? "eager" : "lazy"}
                        decoding={eager ? "sync" : "async"}
                        {...(eager ? { fetchpriority: "high" } : {})}
                        class:list={[...imgClass, coverDark && "cover-img-light"]}
                    />
                )}
                {coverDark && (
                    <Image
                        src={coverDark}
                        alt={title}
                        widths={widths}
                        sizes={sizes}
                        loading={eager ? "eager" : "lazy"}
                        decoding={eager ? "sync" : "async"}
                        {...(eager ? { fetchpriority: "high" } : {})}
                        class:list={[...imgClass, cover && "cover-img-dark"]}
                    />
                )}
            </>
        ) : (
            <span
                class:list={[
                    "font-black text-foreground/90 lowercase tracking-tight leading-none text-center",
                    size === "lg"
                        ? "text-4xl sm:text-5xl"
                        : "text-2xl sm:text-3xl",
                ]}
            >
                {title}
            </span>
        )
    }
    {
        badge && (
            <span
                class:list={[
                    "absolute top-2.5 right-2.5 rounded-full bg-black/70 text-white backdrop-blur-sm font-medium lowercase tracking-wide",
                    size === "lg"
                        ? "text-xs px-2.5 py-1"
                        : "text-[10px] px-2 py-0.5",
                ]}
            >
                {badge}
            </span>
        )
    }
</div>

<style>
    .cover-bg {
        background: var(--cover-bg-light);
    }
    :global(.dark) .cover-bg {
        background: var(--cover-bg-dark);
    }
    :global(.dark) .cover-img-light {
        display: none;
    }
    .cover-img-dark {
        display: none;
    }
    :global(.dark) .cover-img-dark {
        display: block;
    }
</style>
