---
import Layout from "../../layouts/Layout.astro";
import {
    buildBreadcrumb,
    getPublishedPosts,
    resolveSiteURL,
} from "@/lib/content";

const posts = await getPublishedPosts();

const siteURL = resolveSiteURL(Astro.site);

const blogSchema = {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "Notes — Sakib Hasan",
    description:
        "Notes on TypeScript, Go, Cloudflare Workers, and building for the web.",
    url: new URL("/blog", siteURL).href,
    author: {
        "@type": "Person",
        name: "Sakib Hasan",
        url: siteURL.href,
    },
    blogPost: posts.map((post) => ({
        "@type": "BlogPosting",
        headline: post.data.title,
        description: post.data.description,
        datePublished: post.data.date.toISOString(),
        url: new URL(`/blog/${post.id}`, siteURL).href,
        author: { "@type": "Person", name: "Sakib Hasan" },
        keywords: post.data.tags?.join(", "),
    })),
};

const breadcrumb = buildBreadcrumb([
    { name: "Home", item: siteURL.href },
    { name: "Notes", item: new URL("/blog", siteURL).href },
]);
---

<Layout
    title="Notes — Sakib Hasan"
    description="Notes on TypeScript, Go, Cloudflare Workers, and building for the web."
    tags={["TypeScript", "Go", "Cloudflare Workers", "Engineering Notes"]}
    structuredData={[blogSchema, breadcrumb]}
>
    <section>
        <h1
            class="text-6xl sm:text-7xl font-black tracking-tight leading-none mb-4 lowercase"
        >
            notes
        </h1>
        <p class="text-xl text-muted-foreground max-w-xl mb-12">
            thoughts on typescript, go, cloudflare workers, and building for
            the web.
        </p>

        {
            posts.length === 0 ? (
                <p class="text-muted-foreground">
                    no posts yet. check back soon.
                </p>
            ) : (
                <ul class="space-y-1">
                    {posts.map((post) => (
                        <li>
                            <a
                                href={`/blog/${post.id}`}
                                class="group flex items-baseline gap-3 py-2 border-b border-border"
                            >
                                <span class="text-primary shrink-0">→</span>
                                <div class="flex-1 min-w-0">
                                    <div class="group-hover:text-primary transition lowercase">
                                        {post.data.title}
                                    </div>
                                    <p class="text-sm text-muted-foreground truncate">
                                        {post.data.description}
                                    </p>
                                </div>
                                <time
                                    class="text-sm text-muted-foreground shrink-0 tabular-nums"
                                    datetime={post.data.date.toISOString()}
                                >
                                    {post.data.date.toLocaleDateString(
                                        "en-US",
                                        {
                                            year: "numeric",
                                            month: "short",
                                            day: "numeric",
                                        },
                                    )}
                                </time>
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </section>
</Layout>
