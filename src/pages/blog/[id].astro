---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { id: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
    title={`${post.data.title} — Sakib Hasan`}
    description={post.data.description}
>
    <article>
        <a
            href="/blog"
            class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-primary transition mb-8"
        >
            ← back to notes
        </a>

        <header class="mb-10">
            <h1
                class="text-4xl sm:text-5xl font-black tracking-tight leading-tight mb-4"
            >
                {post.data.title}
            </h1>
            <div
                class="flex flex-wrap items-center gap-3 text-sm text-muted-foreground"
            >
                <time datetime={post.data.date.toISOString()}>
                    {
                        post.data.date.toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        })
                    }
                </time>
                {
                    post.data.tags.length > 0 && (
                        <>
                            <span>·</span>
                            <div class="flex gap-2">
                                {post.data.tags.map((tag) => (
                                    <span class="lowercase">#{tag}</span>
                                ))}
                            </div>
                        </>
                    )
                }
            </div>
        </header>

        <div class="prose prose-lg">
            <Content />
        </div>
    </article>
</Layout>
