---
import { ContactForm } from "@/components/ContactForm";
import Layout from "@/layouts/Layout.astro";

const siteURL = Astro.site ?? new URL("https://sakibhasan.dev");
const contactURL = new URL("/contact", siteURL).href;

const contactSchema = {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: "Contact — Sakib Hasan",
    description:
        "Get in touch with Sakib Hasan — for freelance, collaboration, or just to say hello.",
    url: contactURL,
    mainEntity: {
        "@type": "Person",
        name: "Sakib Hasan",
        url: siteURL.href,
        sameAs: [
            "https://github.com/shakibhasan09",
            "https://x.com/sakibhasanme09",
            "https://www.facebook.com/sakibhasan.dev/",
        ],
    },
};

const breadcrumb = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: siteURL.href },
        {
            "@type": "ListItem",
            position: 2,
            name: "Contact",
            item: contactURL,
        },
    ],
};
---

<Layout
    title="Contact — Sakib Hasan"
    description="Get in touch with Sakib Hasan — for freelance, collaboration, or just to say hello."
    structuredData={[contactSchema, breadcrumb]}
>
    <section>
        <h1
            class="text-6xl sm:text-7xl font-black tracking-tight leading-none mb-4 lowercase"
        >
            say hello
        </h1>
        <p class="text-xl text-muted-foreground max-w-xl mb-12">
            got a project in mind, want to collaborate, or just want to say
            hello? drop a message and i'll get back to you.
        </p>

        <div class="rounded-xl border border-border bg-card p-6 sm:p-8 mb-12">
            <ContactForm client:load />
        </div>

        <div class="border-t border-border pt-8">
            <h2 class="text-2xl font-bold lowercase mb-4">find me elsewhere</h2>
            <div class="flex flex-wrap gap-x-6 gap-y-3">
                <a
                    href="https://github.com/shakibhasan09"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-muted-foreground hover:text-primary transition"
                >
                    <svg
                        class="h-5 w-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
                        ></path></svg
                    >
                    github
                </a>
                <a
                    href="https://x.com/sakibhasanme09"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-muted-foreground hover:text-primary transition"
                >
                    <svg
                        class="h-5 w-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                        ></path></svg
                    >
                    x / twitter
                </a>
                <a
                    href="https://www.facebook.com/sakibhasan.dev/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-muted-foreground hover:text-primary transition"
                >
                    <svg
                        class="h-5 w-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                        ></path></svg
                    >
                    facebook
                </a>
            </div>
        </div>
    </section>
</Layout>
