---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ProjectCover from "@/components/ProjectCover.astro";

const allProjects = (await getCollection("projects"))
    .filter((project) => !project.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
    title="work — Sakib Hasan"
    description="case studies and open source — backend systems, edge infrastructure, and developer tooling."
>
    <section>
        <h1
            class="text-6xl sm:text-7xl font-black tracking-tight leading-none mb-4 lowercase"
        >
            work
        </h1>
        <p class="text-xl text-muted-foreground max-w-xl mb-12">
            client projects and open source tools i've built and maintain.
        </p>

        {
            allProjects.length === 0 ? (
                <p class="text-muted-foreground">
                    no projects yet. check back soon.
                </p>
            ) : (
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    {allProjects.map((project) => (
                        <a
                            href={`/projects/${project.id}`}
                            class="group block"
                        >
                            <div class="mb-3">
                                <ProjectCover
                                    cover={project.data.cover}
                                    coverDark={project.data.coverDark}
                                    title={project.data.title}
                                    seed={project.id}
                                    hover
                                />
                            </div>
                            <h3 class="font-semibold text-foreground group-hover:text-primary transition lowercase flex items-center gap-2">
                                {project.data.title}
                                {project.data.stars > 0 && (
                                    <span class="inline-flex items-center gap-1 text-xs text-muted-foreground font-normal">
                                        <svg
                                            class="h-3 w-3"
                                            fill="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                        </svg>
                                        {project.data.stars}
                                    </span>
                                )}
                            </h3>
                            <p class="text-sm text-muted-foreground leading-snug line-clamp-2">
                                {project.data.description}
                            </p>
                        </a>
                    ))}
                </div>
            )
        }
    </section>
</Layout>
