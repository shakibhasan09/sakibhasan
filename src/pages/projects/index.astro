---
import { buttonVariants } from "@/components/ui/button";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const allProjects = (await getCollection("projects"))
    .filter((project) => !project.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const clientProjects = allProjects.filter((p) => p.data.type === "client");
const openSourceProjects = allProjects.filter((p) => p.data.type !== "client");
---

<Layout
    title="Projects — Sakib Hasan"
    description="Case studies and open source tools — backend systems, edge infrastructure, and developer tooling."
>
    <section class="py-8">
        <h1 class="text-2xl font-bold text-foreground mb-2">Selected Work</h1>
        <p class="text-muted-foreground mb-12">
            Case studies from client projects and open source tools I've built and maintain.
        </p>

        {
            clientProjects.length > 0 && (
                <>
                    <h2 class="text-xs font-medium uppercase tracking-wider text-muted-foreground mb-6">
                        Client Work
                    </h2>
                    <div class="space-y-6 mb-12">
                        {clientProjects.map((project) => (
                            <a
                                href={`/projects/${project.id}`}
                                class="block rounded-lg border border-border p-6 hover:bg-muted/50 transition-all group"
                            >
                                <div class="flex items-start justify-between mb-1">
                                    <h3 class="font-semibold text-foreground text-lg">
                                        {project.data.title}
                                    </h3>
                                    <svg
                                        class="h-4 w-4 text-muted-foreground group-hover:text-foreground transition-colors mt-1.5 shrink-0"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="1.5"
                                            d="M9 5l7 7-7 7"
                                        />
                                    </svg>
                                </div>

                                {project.data.problem && (
                                    <div class="mt-3 space-y-2">
                                        <p class="text-sm text-muted-foreground">
                                            <span class="font-medium text-foreground">Problem:</span> {project.data.problem}
                                        </p>
                                        <p class="text-sm text-muted-foreground">
                                            <span class="font-medium text-foreground">Solution:</span> {project.data.solution}
                                        </p>
                                    </div>
                                )}

                                {project.data.results.length > 0 && (
                                    <ul class="mt-3 space-y-1">
                                        {project.data.results.map((result) => (
                                            <li class="flex items-center gap-2 text-sm text-emerald-500">
                                                <svg class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                                </svg>
                                                <span class="text-foreground">{result}</span>
                                            </li>
                                        ))}
                                    </ul>
                                )}

                                <div class="flex flex-wrap gap-2 mt-4">
                                    {project.data.tags.map((tag) => (
                                        <span class="rounded-md bg-muted px-2 py-0.5 text-xs text-muted-foreground">
                                            {tag}
                                        </span>
                                    ))}
                                </div>
                            </a>
                        ))}
                    </div>
                </>
            )
        }

        {
            openSourceProjects.length > 0 && (
                <>
                    <h2 class="text-xs font-medium uppercase tracking-wider text-muted-foreground mb-6">
                        Open Source
                    </h2>
                    <div class="space-y-6">
                        {openSourceProjects.map((project) => (
                            <a
                                href={`/projects/${project.id}`}
                                class="block rounded-lg border border-border p-6 hover:bg-muted/50 transition-all group"
                            >
                                <div class="flex items-start justify-between mb-1">
                                    <h3 class="font-semibold text-foreground text-lg flex items-center gap-2">
                                        {project.data.title}
                                        {project.data.stars > 0 && (
                                            <span class="inline-flex items-center gap-1 text-xs text-muted-foreground font-normal">
                                                <svg
                                                    class="h-3 w-3"
                                                    fill="currentColor"
                                                    viewBox="0 0 24 24"
                                                >
                                                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                                </svg>
                                                {project.data.stars}
                                            </span>
                                        )}
                                    </h3>
                                    <svg
                                        class="h-4 w-4 text-muted-foreground group-hover:text-foreground transition-colors mt-1.5 shrink-0"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="1.5"
                                            d="M9 5l7 7-7 7"
                                        />
                                    </svg>
                                </div>

                                {project.data.problem && (
                                    <div class="mt-3 space-y-2">
                                        <p class="text-sm text-muted-foreground">
                                            <span class="font-medium text-foreground">Problem:</span> {project.data.problem}
                                        </p>
                                        <p class="text-sm text-muted-foreground">
                                            <span class="font-medium text-foreground">Solution:</span> {project.data.solution}
                                        </p>
                                    </div>
                                )}

                                {project.data.results.length > 0 && (
                                    <ul class="mt-3 space-y-1">
                                        {project.data.results.map((result) => (
                                            <li class="flex items-center gap-2 text-sm text-emerald-500">
                                                <svg class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                                </svg>
                                                <span class="text-foreground">{result}</span>
                                            </li>
                                        ))}
                                    </ul>
                                )}

                                <div class="flex flex-wrap gap-2 mt-4">
                                    {project.data.tags.map((tag) => (
                                        <span class="rounded-md bg-muted px-2 py-0.5 text-xs text-muted-foreground">
                                            {tag}
                                        </span>
                                    ))}
                                </div>
                            </a>
                        ))}
                    </div>
                </>
            )
        }

        {
            allProjects.length === 0 && (
                <p class="text-muted-foreground">
                    No projects yet. Check back soon.
                </p>
            )
        }
    </section>

    <!-- CTA -->
    <section class="py-10">
        <div class="rounded-lg border border-border bg-muted/30 p-8 text-center">
            <h2 class="text-xl font-semibold text-foreground mb-2">
                Want something like this built?
            </h2>
            <p class="text-muted-foreground mb-6 max-w-md mx-auto">
                I'm available for freelance and contract work. Let's talk about your project.
            </p>
            <a href="/contact" class={buttonVariants({ size: "lg" })}>
                Start a conversation
            </a>
        </div>
    </section>
</Layout>
