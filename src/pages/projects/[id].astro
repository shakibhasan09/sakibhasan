---
import { buttonVariants } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { id: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout
    title={`${project.data.title} — Sakib Hasan`}
    description={project.data.description}
>
    <article class="py-8">
        <header class="mb-10">
            <a
                href="/projects"
                class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground transition-colors mb-6"
            >
                <svg
                    class="h-4 w-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.5"
                        d="M15 19l-7-7 7-7"></path>
                </svg>
                Back to projects
            </a>

            <div class="flex items-center gap-3 mb-3">
                <span
                    class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground"
                >
                    {
                        project.data.type === "client"
                            ? "Client Work"
                            : "Open Source"
                    }
                </span>
                <span class="text-muted-foreground/40">·</span>
                <time
                    class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground"
                    datetime={project.data.date.toISOString()}
                >
                    {
                        project.data.date.toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "long",
                        })
                    }
                </time>
            </div>

            <h1
                class="text-2xl sm:text-3xl font-bold text-foreground leading-tight mb-3"
            >
                {project.data.title}
            </h1>
            <p class="text-lg text-muted-foreground leading-relaxed mb-6">
                {project.data.description}
            </p>

            <!-- Tags + Link -->
            <div class="flex flex-wrap items-center gap-3">
                <a
                    href={project.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={buttonVariants({ size: "sm" })}
                >
                    {
                        project.data.type === "client" ? (
                            <>
                                <svg
                                    class="h-4 w-4"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.5"
                                        d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"
                                    />
                                </svg>
                                Visit site
                            </>
                        ) : (
                            <>
                                <svg
                                    class="h-4 w-4"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                                </svg>
                                View on GitHub
                            </>
                        )
                    }
                </a>
                {
                    project.data.tags.map((tag) => (
                        <span class="rounded-md bg-muted border border-border px-2.5 py-1 text-xs text-muted-foreground">
                            {tag}
                        </span>
                    ))
                }
            </div>
        </header>

        <div class="prose">
            <Content />
        </div>

        <!-- CTA -->
        <div
            class="mt-12 rounded-lg border border-border bg-muted/30 p-8 text-center"
        >
            <h2 class="text-xl font-semibold text-foreground mb-2">
                Want something like this built?
            </h2>
            <p class="text-muted-foreground mb-6 max-w-md mx-auto">
                I'm available for freelance and contract work. Let's discuss
                your project.
            </p>
            <a href="/contact" class={buttonVariants({ size: "lg" })}>
                Start a conversation
            </a>
        </div>
    </article>
</Layout>
